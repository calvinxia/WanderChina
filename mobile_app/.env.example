# Backend Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# TENCENT CLOUD POSTGRESQL
# ============================================================================
DB_HOST=your-tencentcloud-host.com
DB_PORT=5432
DB_NAME=wanderchina
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
DB_SSL=true

# ============================================================================
# CLOUDFLARE R2 STORAGE
# ============================================================================
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_DOMAIN=https://cdn.wanderchina.app

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# ============================================================================
# API CONFIGURATION (Optional)
# ============================================================================
API_BASE_URL=https://api.wanderchina.app

# ============================================================================
# INSTRUCTIONS
# ============================================================================
# 1. Copy this file to .env
# 2. Fill in your credentials
# 3. Add .env to .gitignore to keep credentials secret
# 4. Use --dart-define-from-file=.env when running:
#    flutter run --dart-define-from-file=.env
